# コピーして backend/.env を作成（.env はコミットしない）
# jquants: 実データ / demo: 合成データ（DBファイルを分けること）
STOCK_DATA_MODE=jquants
STOCK_DB_PATH=./data/stock.db

# J-Quants API V2（ダッシュボード「設定 » APIキー」で発行）。当日終値の取得には Light 以上が必要
JQUANTS_API_KEY=
JQUANTS_BASE_URL=https://api.jquants.com/v2

# EDINET API v2（無料・要登録）
EDINET_API_KEY=

# Webアプリのアクセストークン。LAN/外部から使う場合は必須（未設定時はローカルのみ）
STOCK_APP_TOKEN=

# Web Push（`npx web-push generate-vapid-keys` で生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 終値待ちの締切（これを過ぎると遅延通知。以降も再取得は続ける）
STOCK_DATA_DEADLINE=20:00
STOCK_RETRY_INTERVAL_MIN=15
